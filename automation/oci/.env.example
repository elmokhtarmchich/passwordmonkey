# PasswordMonkey n8n — environment values for docker-compose.yml
# setup-vm.sh copies this to .env and generates the encryption key automatically.
# The real .env is git-ignored: never commit, paste, or share it.

# REQUIRED — encrypts n8n credentials at rest. Generate a new one with:
#   openssl rand -base64 32
N8N_ENCRYPTION_KEY=CHANGE_ME_RUN_openssl_rand_base64_32

# Timezone anchoring the Cron trigger schedule.
GENERIC_TIMEZONE=Africa/Casablanca

# n8n image tag. After the first deploy, pin the exact tag you are running
# (see https://hub.docker.com/r/n8nio/n8n/tags) so routine pulls cannot jump major versions.
N8N_IMAGE=n8nio/n8n:latest

# Keep true unless browser login loops with "Could not find cookie" over the SSH tunnel.
N8N_SECURE_COOKIE=true

# Run Code-node JavaScript in isolated task runners. Set false only when troubleshooting
# Code-node failures (then `sudo docker compose up -d` to apply).
N8N_RUNNERS_ENABLED=true
